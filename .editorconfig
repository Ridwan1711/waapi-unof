# EditorConfig — https://editorconfig.org
# Keeps formatting consistent across editors and the three services.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python uses 4 spaces (PEP 8)
[*.py]
indent_size = 4

# Makefiles require real tabs
[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc}]
indent_size = 2
