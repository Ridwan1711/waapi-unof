# ===========================================================================
# waapi-unof — Environment Variables (EXAMPLE)
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# On Dokploy, set these as the service's Environment Variables.
# ===========================================================================

# --------------------------- General ---------------------------------------
COMPOSE_PROJECT_NAME=waapi-unof
NODE_ENV=production
DJANGO_ENV=production
LOG_LEVEL=info

# --------------------------- Public domains (Traefik / Dokploy) -------------
# The hostnames Traefik will route to each public service.
FRONTEND_DOMAIN=wap.ngedeploy.online
API_DOMAIN=wap.api.ngedeploy.online

# --------------------------- Django -----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-please-use-a-long-random-string
DJANGO_DEBUG=false
# Sertakan `api` (nama service di docker network) supaya callback internal
# Node -> Django (http://api:8000/internal/events) tidak ditolak DisallowedHost.
DJANGO_ALLOWED_HOSTS=wap.api.ngedeploy.online,api,localhost,127.0.0.1
# Origin yang dipakai Django admin (di domain API) untuk verifikasi CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=https://wap.api.ngedeploy.online
# Origin frontend yang boleh memanggil API dari browser (CORS).
DJANGO_CORS_ALLOWED_ORIGINS=https://wap.ngedeploy.online

# --------------------------- JWT auth ---------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MIN=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --------------------------- PostgreSQL -------------------------------------
POSTGRES_DB=waapi
POSTGRES_USER=waapi
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Convenience URL used by Django / Celery (kept in sync with the values above).
DATABASE_URL=postgres://waapi:change-me-strong-db-password@postgres:5432/waapi

# --------------------------- Redis ------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --------------------------- Internal service-to-service auth ---------------
# Shared HMAC secret signing every Django <-> Node WA-service request.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=change-me-internal-hmac-secret
# Where Django reaches the Node WA service (internal docker network).
WA_SERVICE_INTERNAL_URL=http://wa-service:8090
# Where the Node WA service posts events back to Django (internal network).
DJANGO_INTERNAL_CALLBACK_URL=http://api:8000/internal

# --------------------------- WhatsApp service -------------------------------
WA_SERVICE_PORT=8090
# Engine selection — abstraction lets us swap without touching Django/Frontend.
#   wwebjs  -> whatsapp-web.js (default; browser-based)
#   baileys -> Baileys (future; lighter, no browser)
WA_DEFAULT_PROVIDER=wwebjs
# Session persistence: local (disk volume) or remote (DB/S3, for scaling).
WA_SESSION_STORAGE=local
WA_DATA_DIR=/data/sessions

# --------------------------- Anti-ban throttling ----------------------------
# Human-like delays + per-number rate limits to reduce ban risk.
WA_SEND_MIN_DELAY_MS=1500
WA_SEND_MAX_DELAY_MS=4000
WA_SEND_RATE_PER_MIN=20

# --------------------------- Storage ----------------------------------------
# local -> disk volume now; s3 -> migrate later with zero business-logic change.
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
# S3 (future)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# --------------------------- Frontend ---------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://wap.api.ngedeploy.online
# Tanpa tanda kutip — di file .env spasi sudah aman, kutip malah bisa ikut kebawa.
NEXT_PUBLIC_APP_NAME=WAP - WA API UNOFFICIAL

# --------------------------- Observability (optional) -----------------------
SENTRY_DSN=
