# ---------------------------------------------------------------------------
# waapi-unof — root .gitignore
# Service-specific ignores live in each service folder when needed.
# ---------------------------------------------------------------------------

# ----- Environment & secrets -----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ----- Python / Django -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
db.sqlite3
db.sqlite3-journal
staticfiles/
mediafiles/

# ----- Node / Next.js -----
node_modules/
.next/
out/
.turbo/
.pnp.*
.yarn/*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ----- WhatsApp service runtime data (sessions, cache, auth) -----
wa-service/.wwebjs_auth/
wa-service/.wwebjs_cache/
data/
sessions/

# ----- Logs -----
logs/
*.log

# ----- OS files -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Editors / IDEs -----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
*.swp
*.swo
*~

# ----- Docker -----
*.local.yml
